# --- GLOBAL & SYSTEM ---
.DS_Store
Thumbs.db

# --- PYTHON GLOBAL (Covers Backend, AI-Service, Scripts) ---
# This automatically covers ANY folder named 'venv' or '__pycache__' in the repo
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.so

# --- ENV SECRETS (CRITICAL) ---
# Ignores .env files in ANY folder (backend, ai-service, mobile, etc.)
**/.env
**/.env.local
**/.env.*.local

# --- LOGS & UPLOADS ---
*.log
**/uploads/
**/logs/

# --- FRONTEND (React) ---
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.eslintcache

# --- MOBILE & ANDROID (Robust) ---
# Ignore node_modules anywhere
**/node_modules/

# Ignore Android Build artifacts anywhere
**/android/build/
**/android/app/build/
**/android/.gradle/
**/*.iml

# Ignore Android local properties (Keys/SDK paths)
**/local.properties

# --- IOS (Robust) ---
**/ios/build/
**/ios/Pods/
**/ios/DerivedData/
*.xcworkspace

# --- TESTING & COVERAGE ---
**/coverage/
**/.pytest_cache/